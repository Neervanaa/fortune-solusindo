# ── MySQL database (import schema.sql into this database first) ──
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=fortune_solusindo
DB_USER=your-db-user
DB_PASS=your-db-password
# Set to "true" if your DB provider requires SSL (e.g. PlanetScale, Aiven)
DB_SSL=false

# ── Session / auth ──
# Random long string used to sign admin login sessions. Generate with:
# openssl rand -base64 48
SESSION_SECRET=change-this-to-a-long-random-string

# ── File uploads (Vercel Blob) ──
# Create a Blob store in your Vercel project (Storage tab) and it will
# inject BLOB_READ_WRITE_TOKEN automatically. For local dev, copy the
# token here from Vercel dashboard > Storage > your store > .env.local tab.
BLOB_READ_WRITE_TOKEN=
