# ── PostgreSQL database (Supabase) ──
# Get these from: Supabase Dashboard → Project Settings → Database → Connection string
# Or from: Settings → API → Database URL
DB_HOST=db.xxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=your-supabase-db-password
# Supabase requires SSL
DB_SSL=true

# ── Session / auth ──
# Random long string used to sign admin login sessions. Generate with:
# openssl rand -base64 48
SESSION_SECRET=change-this-to-a-long-random-string

# ── File uploads (Vercel Blob) ──
# Create a Blob store in your Vercel project (Storage tab) and it will
# inject BLOB_READ_WRITE_TOKEN automatically. For local dev, copy the
# token here from Vercel dashboard > Storage > your store > .env.local tab.
BLOB_READ_WRITE_TOKEN=
